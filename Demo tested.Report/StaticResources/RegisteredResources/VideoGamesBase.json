        ],
        "referenceLabelValue": [
          {
            "valueFontSize": 14
          }
        ],
        "referenceLabelDetail": [
          {
            "detailFontSize": 14
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "text": [
          {
            "fontSize": 14
          }
        ]
      }
    }
