        ],
        "values": [
          {
            "fontSize": 14
          }
        ],
        "total": [
          {
            "fontSize": 14
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 14
          }
