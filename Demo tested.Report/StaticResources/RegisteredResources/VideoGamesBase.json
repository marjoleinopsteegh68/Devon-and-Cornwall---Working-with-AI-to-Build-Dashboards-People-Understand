        "rowHeaders": [
          {
            "fontSize": 14
          }
        ],
        "values": [
          {
            "fontSize": 14
          }
        ],
        "total": [
          {
            "fontSize": 14
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "label": [
          {
            "fontSize": 16
          }
