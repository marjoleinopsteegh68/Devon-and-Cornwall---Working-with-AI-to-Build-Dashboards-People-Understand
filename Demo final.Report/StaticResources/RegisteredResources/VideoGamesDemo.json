{
  "name": "Video games demo",
  "dataColors": [
    "#1F7463",
    "#3F3F3F",
    "#C8C8C8",
    "#6CC3A8",
    "#7F7F7F",
    "#5FA88A",
    "#000000",
    "#A6A6A6"
  ],
  "background": "#FFFFFF",
