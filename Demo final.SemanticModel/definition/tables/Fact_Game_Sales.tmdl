	partition Fact_Game_Sales = m
		mode: import
		source =
				let
				    Source = Source_VGChartz_Raw,
				    // 4 sales columns -> 1 row per game, platform and region
				    #"Unpivoted Regions" = Table.UnpivotOtherColumns(Table.SelectColumns(Source, {"title", "console", "genre", "publisher", "release_date", "critic_score", "na_sales", "pal_sales", "jp_sales", "other_sales"}), {"title", "console", "genre", "publisher", "release_date", "critic_score"}, "Source Column", "Units Sold (millions)"),
				    // Data stops in 2018: 2019 is almost empty
				    #"Filtered Up To 2018" = Table.SelectRows(#"Unpivoted Regions", each [release_date] <> null and [release_date] < #date(2019, 1, 1)),
				    #"Added DateKey" = Table.AddColumn(#"Filtered Up To 2018", "DateKey", each Number.From(Date.ToText([release_date], "yyyyMMdd")), Int64.Type),
				    #"Merged Game" = Table.ExpandTableColumn(Table.NestedJoin(#"Added DateKey", {"title"}, Dim_Game, {"Game Title"}, "G", JoinKind.LeftOuter), "G", {"GameKey"}),
				    #"Merged Platform" = Table.ExpandTableColumn(Table.NestedJoin(#"Merged Game", {"console"}, Dim_Platform, {"Platform"}, "P", JoinKind.LeftOuter), "P", {"PlatformKey"}),
				    #"Merged Genre" = Table.ExpandTableColumn(Table.NestedJoin(#"Merged Platform", {"genre"}, Dim_Genre, {"Genre"}, "Ge", JoinKind.LeftOuter), "Ge", {"GenreKey"}),
				    #"Merged Publisher" = Table.ExpandTableColumn(Table.NestedJoin(#"Merged Genre", {"publisher"}, Dim_Publisher, {"Publisher"}, "Pu", JoinKind.LeftOuter), "Pu", {"PublisherKey"}),
				    Regions = #table(type table [RegionKey = Int64.Type, #"Source Column" = text], {{1, "na_sales"}, {2, "pal_sales"}, {3, "jp_sales"}, {4, "other_sales"}}),
				    #"Merged Region" = Table.ExpandTableColumn(Table.NestedJoin(#"Merged Publisher", {"Source Column"}, Regions, {"Source Column"}, "R", JoinKind.LeftOuter), "R", {"RegionKey"}),
				    #"Renamed" = Table.RenameColumns(#"Merged Region", {{"critic_score", "Critic Score"}}),
				    #"Selected Columns" = Table.SelectColumns(#"Renamed", {"GameKey", "PlatformKey", "GenreKey", "PublisherKey", "RegionKey", "DateKey", "Units Sold (millions)", "Critic Score"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"Units Sold (millions)", type number}, {"Critic Score", type number}})
				in
				    #"Changed Type"

